/* pages/my/my.wxss */

.my-container {
  min-height: 100vh;
  background: #f7f8fa;
}

/* 用户信息区域 */
.user-section {
  background: linear-gradient(135deg, #07C160 0%, #06ad56 100%);
  padding: 80rpx 28rpx 28rpx;
  border-bottom-left-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 20rpx rgba(12,18,29,0.06);
}

.user-detail {
  flex: 1;
  margin-left: 20rpx;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.edit-profile {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.logout-btn {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  border: none;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.login-btn {
  background: #fff;
  color: #07C160;
  font-size: 32rpx;
  font-weight: 600;
  padding: 18rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

.login-tip {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.card {
  background: #fff;
  margin: 18rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(12,18,29,0.06);
}

/* 统计数据 */
.stats-section {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #f0f2f5;
}

/* 菜单列表 */
.menu-section {
  padding: 0 14rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f4f6f8;
  color: #07C160;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #c6ced6;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 56rpx 0;
  color: #999;
  font-size: 24rpx;
}