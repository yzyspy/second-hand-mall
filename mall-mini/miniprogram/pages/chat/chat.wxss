.page { display: flex; flex-direction: column; height: 100vh; background: #f0f0f0; }

.msg-list { flex: 1; padding: 20rpx; overflow-y: auto; }

.msg-row { display: flex; margin-bottom: 20rpx; }
.msg-row.right { flex-direction: row-reverse; }

.bubble {
  max-width: 60vw;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.msg-row.left .bubble { background: #fff; color: #333; border-top-left-radius: 4rpx; }
.msg-row.right .bubble { background: #07C160; color: #fff; border-top-right-radius: 4rpx; }

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #07C160;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}
